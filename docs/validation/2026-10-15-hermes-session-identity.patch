diff --git a/tools/mcp_tool_session_headers.py b/tools/mcp_tool_session_headers.py
new file mode 100644
index 00000000000..574b65a930f
--- /dev/null
+++ b/tools/mcp_tool_session_headers.py
@@ -0,0 +1,75 @@
+"""Carry a caller's session identity on individual Streamable HTTP messages.
+
+The SDK writer runs in another task, so connection defaults or HTTP-task
+ContextVars cannot identify the originating chat. Stamp message metadata before
+it enters that queue; the identity never becomes a tool argument or JSON _meta.
+"""
+
+from contextlib import contextmanager
+from contextvars import ContextVar
+from dataclasses import replace
+
+_session_id = ContextVar("mcp_call_session_id", default=None)
+
+
+def session_header_name(config: dict) -> str | None:
+    raw = config.get("identity_header")
+    if not isinstance(raw, dict) or str(raw.get("value_from") or "").strip().lower() != "session":
+        return None
+    name = raw.get("name")
+    if not isinstance(name, str) or not name.strip():
+        return None
+    name = name.strip()
+    if any(key.lower() == name.lower() for key in config.get("headers") or {}):
+        return None  # Existing explicit-header precedence also applies here.
+    return name
+
+
+@contextmanager
+def session_identity(session_id):
+    token = _session_id.set(session_id or None)
+    try:
+        yield
+    finally:
+        _session_id.reset(token)
+
+
+class _SessionHeaderStream:
+    def __init__(self, stream, name):
+        self._stream = stream
+        self._name = name
+
+    async def send(self, item):
+        identity = _session_id.get()
+        if identity:
+            if not isinstance(identity, str) or not identity.isascii() or any(ord(char) < 32 or ord(char) == 127 for char in identity):
+                raise ValueError("MCP session identity must be an ASCII header value without control characters")
+            from mcp.shared.message import ClientMessageMetadata
+            metadata = item.metadata or ClientMessageMetadata()
+            headers = dict(metadata.headers or {})
+            headers[self._name] = identity
+            item = replace(item, metadata=replace(metadata, headers=headers))
+        await self._stream.send(item)
+
+    def __getattr__(self, name):
+        return getattr(self._stream, name)
+
+    def clone(self):
+        return _SessionHeaderStream(self._stream.clone(), self._name)
+
+    async def __aenter__(self):
+        await self._stream.__aenter__()
+        return self
+
+    async def __aexit__(self, *args):
+        return await self._stream.__aexit__(*args)
+
+
+def session_header_stream(stream, config: dict, transport: str):
+    name = session_header_name(config)
+    if name is None:
+        return stream
+    from mcp.shared.message import ClientMessageMetadata
+    if transport != "HTTP" or "headers" not in ClientMessageMetadata.__dataclass_fields__:
+        raise ValueError("identity_header value_from: session requires Streamable HTTP with MCP SDK 2.x")
+    return _SessionHeaderStream(stream, name)
diff --git a/tests/tools/test_mcp_session_identity.py b/tests/tools/test_mcp_session_identity.py
new file mode 100644
index 00000000000..d839631a13f
--- /dev/null
+++ b/tests/tools/test_mcp_session_identity.py
@@ -0,0 +1,133 @@
+"""Session identity must travel with each HTTP RPC, even on a shared connection."""
+
+from __future__ import annotations
+
+import json
+import threading
+from copy import deepcopy
+from concurrent.futures import ThreadPoolExecutor
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+
+import pytest
+
+
+@pytest.fixture
+def rpc_servers(monkeypatch):
+    monkeypatch.setenv("NO_PROXY", "*")
+    monkeypatch.setenv("HERMES_SESSION_ID", "unrelated-launch-session")
+    servers = []
+
+    def start():
+        state = {"calls": [], "redirect": None}
+
+        class Handler(BaseHTTPRequestHandler):
+            def log_message(self, *args):
+                pass
+
+            def do_HEAD(self):
+                self.send_response(200)
+                self.send_header("Content-Type", "application/json")
+                self.end_headers()
+
+            def do_GET(self):
+                self.send_response(405)
+                self.end_headers()
+
+            def do_POST(self):
+                request = json.loads(self.rfile.read(int(self.headers["Content-Length"])))
+                method = request["method"]
+                if method == "tools/call":
+                    state["calls"].append((self.headers.get("X-Test-Conversation"), request))
+                    if state["redirect"] and self.path == "/mcp":
+                        self.send_response(307)
+                        self.send_header("Location", state["redirect"])
+                        self.end_headers()
+                        return
+                if "id" not in request:
+                    self.send_response(202)
+                    self.end_headers()
+                    return
+                result = {
+                    "initialize": {"protocolVersion": "2025-06-18", "capabilities": {"tools": {}},
+                                   "serverInfo": {"name": "identity-test", "version": "1"}},
+                    "tools/list": {"tools": [{"name": "echo", "inputSchema": {"type": "object"},
+                                              "annotations": {"readOnlyHint": True}}]},
+                    "tools/call": {"content": [{"type": "text", "text": self.headers.get("X-Test-Conversation", "NONE")}]},
+                    "ping": {},
+                }.get(method, {})
+                body = json.dumps({"jsonrpc": "2.0", "id": request["id"], "result": result}).encode()
+                self.send_response(200)
+                self.send_header("Content-Type", "application/json")
+                self.send_header("Content-Length", str(len(body)))
+                self.end_headers()
+                self.wfile.write(body)
+
+        server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
+        thread = threading.Thread(target=server.serve_forever, daemon=True)
+        thread.start()
+        servers.append((server, thread))
+        return f"http://127.0.0.1:{server.server_port}/mcp", state
+
+    yield start
+    from tools.mcp_tool_lifecycle import shutdown_mcp_servers
+    shutdown_mcp_servers()
+    for server, thread in servers:
+        server.shutdown()
+        server.server_close()
+        thread.join(5)
+
+
+def connect(url, *, headers=None):
+    from tools.mcp_tool_discovery import register_mcp_servers
+    config = {"url": url, "identity_header": {"name": "X-Test-Conversation", "value_from": "session"}}
+    if headers:
+        config["headers"] = headers
+    names = register_mcp_servers({"identity": config})
+    assert "mcp__identity__echo" in names
+    return config
+
+
+def call(session_id=None):
+    from tools.registry import registry
+    result = json.loads(registry.dispatch("mcp__identity__echo", {}, session_id=session_id))
+    assert "error" not in result, result
+    return result["result"]
+
+
+def test_session_identity_isolated_across_calls_threads_and_reconnects(rpc_servers):
+    url, state = rpc_servers()
+    config = connect(url)
+    from tools import mcp_tool
+    from tools.mcp_tool_registration import _same_server_route
+    changed = deepcopy(config)
+    changed["identity_header"]["name"] = "X-Another-Conversation"
+    assert _same_server_route(mcp_tool._servers["identity"], config)
+    assert not _same_server_route(mcp_tool._servers["identity"], changed), "Different header mappings cannot share a live connection"
+    assert call("chat-a") == "chat-a"
+    assert call("chat-b") == "chat-b"
+    assert call("chat-a") == "chat-a"
+    assert call() == "NONE", "A missing caller ID must not borrow the launch session"
+    with ThreadPoolExecutor(max_workers=2) as executor:
+        a = executor.submit(call, "chat-a")
+        b = executor.submit(call, "chat-b")
+        assert (a.result(30), b.result(30)) == ("chat-a", "chat-b")
+    from tools.mcp_tool_lifecycle import shutdown_mcp_servers
+    shutdown_mcp_servers()
+    connect(url)
+    assert call("chat-a") == "chat-a", "Reconnect must preserve the caller's conversation identity"
+    assert all("session_id" not in str(request["params"]) for _, request in state["calls"])
+    shutdown_mcp_servers()
+    connect(url, headers={"x-test-conversation": "explicit-static"})
+    assert call("chat-a") == "explicit-static", "Explicit user headers retain their existing precedence"
+
+
+def test_dynamic_session_header_follows_same_origin_but_never_cross_origin(rpc_servers):
+    url, origin = rpc_servers()
+    sink_url, sink = rpc_servers()
+    connect(url)
+    origin["redirect"] = url.replace("/mcp", "/forward")
+    assert call("private-chat-a") == "private-chat-a"
+    origin["redirect"] = sink_url
+    assert call("private-chat-a") == "NONE"
+    assert sink["calls"][-1][0] is None
+    assert "private-chat-a" not in json.dumps(sink["calls"][-1][1]), "Identity must not be hidden in JSON params either"
